{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "packageManager": "npm",
  "ignorePatterns": [
    "ios",
    "android",
    "dist",
    "coverage",
    ".expo",
    "reports",
    "*.tsbuildinfo"
  ],
  "testRunner": "jest",
  "jest": {
    "projectType": "custom",
    "enableFindRelatedTests": true
  },
  "coverageAnalysis": "perTest",
  "mutate": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "App.tsx",
    "!src/**/__tests__/**",
    "!src/maps/types.ts"
  ],
  "reporters": [
    "html",
    "clear-text",
    "progress"
  ],
  "htmlReporter": {
    "fileName": "reports/mutation/index.html"
  },
  "tempDirName": ".stryker-tmp",
  "thresholds": {
    "high": 90,
    "low": 80,
    "break": 80
  }
}
